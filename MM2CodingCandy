-- SISTEMA ANTI FLING E NOCLIP
-- ==========================================
local lastFlingCheck = 0
RunService.Heartbeat:Connect(function()
    if not AntiFlingEnabled and not AutoCandyRunning then return end
    local now = tick()
    
    if now - lastFlingCheck >= 0.2 then
        lastFlingCheck = now
        
        if AntiFlingEnabled then
            for _, otherPlayer in pairs(Players:GetPlayers()) do
                if otherPlayer ~= LocalPlayer and otherPlayer.Character then
                    for _, part in pairs(otherPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end
        end

        if AutoCandyRunning and LocalPlayer.Character then
            for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end
end)

local function IsRealCandy(part)
    if not part or not part.Parent or not part:IsDescendantOf(workspace) then 
        return false 
    end
    if part:IsA("BasePart") then
        if part.Transparency >= 1 or not part.CanTouch then
            return false
        end
    end
    return true
end

-- Teleporte Tween - Vai até encostar perfeitamente no doce
local function TeleportToCandy(targetPart)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    local rootPart = character.HumanoidRootPart
    if not IsRealCandy(targetPart) then return end

    local distance = (rootPart.Position - targetPart.Position).Magnitude
    local timeToTravel = distance / TweenSpeed

    local centerPosition = CFrame.new(targetPart.Position)
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = centerPosition})
    
    tween:Play()

    while AutoCandyRunning and IsRealCandy(targetPart) do
        local currentDist = (rootPart.Position - targetPart.Position).Magnitude
        if currentDist <= 0.2 then
            break
        end
        task.wait()
    end

    tween:Cancel()
end

local function GetClosestCandies()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return {} end
    
    local rootPart = character.HumanoidRootPart
    local candyList = {}

    local container = workspace:FindFirstChild("Normal") or workspace
    for _, obj in pairs(container:GetDescendants()) do
        local nameLower = obj.Name:lower()
        if nameLower:find("candy") or nameLower:find("coin") then
            local targetPart = nil
            if obj:IsA("BasePart") then
                targetPart = obj
            elseif obj:IsA("Model") then
                targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            end

            if IsRealCandy(targetPart) then
                local dist = (rootPart.Position - targetPart.Position).Magnitude
                table.insert(candyList, {Part = targetPart, Distance = dist})
            end
        end
    end

    table.sort(candyList, function(a, b)
        return a.Distance < b.Distance
    end)

    return candyList
end

-- Loop Principal de Coleta
local triggeredFlingForEvent = false

task.spawn(function()
    while true do
        if AutoCandyRunning then
            local bagFull = CheckBagFullOrEmpty()
            local candyList = GetClosestCandies()

            if bagFull or #candyList == 0 then
                if not triggeredFlingForEvent then
                    triggeredFlingForEvent = true
                    TriggerAutoFling()
                end
            else
                triggeredFlingForEvent = false
                local closest = candyList[1]
                if IsRealCandy(closest.Part) then
                    TeleportToCandy(closest.Part)
                end
            end
            task.wait(0.05)
        else
            triggeredFlingForEvent = false
            task.wait(0.3)
        end
    end
end)

