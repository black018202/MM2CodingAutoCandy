local function GetPlayerRole(player)
    local character = player.Character
    if not character then return "Innocent" end
    
    if player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife") then return "Murderer" end
    if character:FindFirstChild("Knife") then return "Murderer" end
    
    if player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Gun") then return "Sheriff" end
    if character:FindFirstChild("Gun") then return "Sheriff" end
    
    return "Innocent"
end

local function ApplyHighlight(player, role)
    if not player.Character then return end
    
    local highlight = player.Character:FindFirstChild("DracoswESP")
    local shouldShow = false
    local color = Color3.fromRGB(255, 255, 255)

    if role == "Murderer" and EspMurderEnabled then
        shouldShow = true
        color = Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" and EspSheriffEnabled then
        shouldShow = true
        color = Color3.fromRGB(0, 100, 255)
    elseif role == "Innocent" and EspInnocentEnabled then
        shouldShow = true
        color = Color3.fromRGB(0, 255, 0)
    end

    if shouldShow then
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "DracoswESP"
            highlight.Parent = player.Character
        end
        highlight.FillColor = color
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Enabled = true
    else
        if highlight then
            highlight.Enabled = false
        end
    end
end

task.spawn(function()
    while true do
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                pcall(function()
                    local role = GetPlayerRole(player)
                    ApplyHighlight(player, role)
                end)
            end
        end
        task.wait(0.5)
    end
end)

